{
  "name": "torqq-backend",
  "version": "1.0.0",
  "description": "TORQQ Carpool/Shuttle Platform Backend",
  "main": "server.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:client": "npm --prefix client run dev",
    "dev:admin": "npm --prefix admin run dev",
    "check:startup": "node scripts/checkStartup.js",
    "check:contract": "node scripts/contractCheck.js",
    "migrate:durable-stops": "node scripts/migrations/backfillDurableStops.js",
    "prepare": "node scripts/installGitHooks.js",
    "pretest": "npm run check:contract",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test test/subscriptionService.unit.test.js test/subscriptionPolicy.test.js test/durableStopPersistence.test.js test/flexyRideRequestContract.test.js test/customerPasswordLoginMismatch.exploration.test.js test/customerPasswordLoginMismatch.preservation.test.js",
    "test:integration": "node --test test/subscriptionService.integration.test.js test/subscriptionPurchase.integration.test.js test/tripGenerator.integration.test.js test/tripGenerator.property.test.js test/flexyLifecycle.test.js test/customerOtpAccountRoleCorrection.exploration.test.js test/customerOtpAccountRoleCorrection.preservation.test.js",
    "test:durable-stops": "node --test test/durableStopPersistence.test.js",
    "test:subscription-policy": "node --test test/subscriptionPolicy.test.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^8.7.0",
    "multer": "^1.4.5-lts.1",
    "razorpay": "^2.9.4",
    "socket.io": "^4.8.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "fast-check": "3.23.2",
    "nodemon": "^3.1.0"
  }
}
