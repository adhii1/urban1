# TORQQ backend configuration — TEMPLATE
#
# Copy this to the file matching your NODE_ENV, then fill in the blanks:
#   development (default) -> .env.dev
#   test                  -> .env.test
#   production            -> .env.prod
#
#   cp .env.example .env.dev
#
# The real .env.* files are gitignored, so a fresh clone has none of them. This
# template is the only one committed — keep it in sync when you add a variable.

# --- Server ------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- Database (required) -----------------------------------------------------
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/<db>?appName=<app>
# Local: mongodb://127.0.0.1:27017/torqq
MONGODB_URI=

# --- Auth (required) ---------------------------------------------------------
# Use long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REFRESH_SECRET=
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# --- CORS --------------------------------------------------------------------
# In development, any localhost / 127.0.0.1 / private-LAN origin is accepted on
# any port, so you normally need nothing here.
#
# In production these two are REQUIRED and the allowlist is exact — no wildcards:
# CLIENT_URL=https://app.example.com
# ADMIN_URL=https://admin.example.com
#
# Comma-separated extras for either environment (staging, preview deploys):
# CORS_EXTRA_ORIGINS=https://staging.example.com,https://preview.example.com

# --- Payments (optional — blank enables mock mode) ---------------------------
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

# --- Maps (optional) ---------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- Email (optional) --------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=

# --- Redis (optional — blank uses in-memory, fine for a single instance) -----
REDIS_URL=
